event: agent_event
data: {"type": "event", "seq": 2, "method": "custom", "params": {"namespace": [], "timestamp": 1792647275584, "data": {"type": "swarm_handoff_mentions", "mentions": [{"alias": "nio", "agentName": "NIO Chat Agent", "description": "Primary general-purpose NIO Chat agent.", "displayLabel": "NIO Chat"}, {"alias": "chatdata", "agentName": "a2a_chat_data_agent", "description": "企业业务数据的自然语言查询与分析（智能问数）。适用于：用户问题是为了获取具体的、量化的企业业务数据，并聚焦可公开验证的指标数值；核心重点在于\"问数\"，即查询真实、已公开的数据结果，而非主观分析、预测或战略解读。支持的指标类型包括但不限于：车辆交付量/交付数/销量、NSC/ASC门店数量、换电站数量、充电枪头/充电桩建设数量、NIO超充桩/目充桩数量（累计/新增）、目充桩功率分类（如20kw/7kw）、已上线超充/目充根数（传播口径）等。支持的查询方式：单指标取数（\"2025年10月交付量是多少？\"）、按维度取数（\"2024年各省交付量情况？\"）、排序排名（\"各品牌的交付量排名？\"）、同比环比（\"今年10月交付量环比增长多少？\"）、占比分析（\"TOP5省份换电站数量占比？\"）。数据来源为指标平台已注册的标准口径指标，涵盖交付量、销售、服务、运营等业务领域。不适用于：非数据查询类问题（如主观分析、战略解读、预测）；指标平台未收录的数据；询问术语/概念定义（如\"什么是CPK\"）；互联网通用工具问题；业务流程咨询。", "displayLabel": "智能问数"}, {"alias": "pcp_agent", "agentName": "a2a_pcp_agent", "description": "口袋书问答助手", "displayLabel": "口袋书问答助手"}]}}}

